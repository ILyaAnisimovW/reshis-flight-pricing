# Пример; Spring Boot не загружает .env автоматически. Задайте переменные в shell/хостинге.
PORT=8080
DB_URL=jdbc:h2:file:./data/accounts
DB_USER=sa
DB_PASSWORD=
COOKIE_SECURE=false

